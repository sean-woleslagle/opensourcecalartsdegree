# Supabase (required for magic-link auth + synced progress)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only allowlist (never NEXT_PUBLIC_*). Set this on Vercel / .env.local.
# ALLOWED_EMAIL=

# Optional: only if you use the service role from scripts (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=
