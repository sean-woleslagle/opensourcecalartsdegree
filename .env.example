# Supabase (required for magic-link auth + synced progress)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional allowlist override (defaults to jacx92@gmail.com). Set in Vercel if needed.
# ALLOWED_EMAIL=jacx92@gmail.com

# Optional: only if you use the service role from scripts (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=
